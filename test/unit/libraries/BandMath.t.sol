pragma solidity 0.8.26;

import {Test} from "forge-std/Test.sol";
import {TickMath} from "@uniswap/v4-core/src/libraries/TickMath.sol";
import {BandMath} from "../../../src/libraries/BandMath.sol";
import {Scenario, Scenarios} from "../../utils/Scenario.sol";

/// @notice BandMath against the committed 80-digit reference (test/data/band_ticks_ref.json, regenerated by
/// tools/gen_band_ref.py). The contractual postcondition (MATH §2, ADR-035) for bps in [1, 2500] is
/// floor(ref) - 1 <= result <= floor(ref), and the biased WAD value never exceeds the exact value.
contract BandMathTest is Test {
    string internal json;
    uint256 internal constant N = 2500;

    function setUp() public {
        json = vm.readFile("test/data/band_ticks_ref.json");
    }

    function _ref(string memory key) internal view returns (uint256[] memory out) {
        string[] memory raw = vm.parseJsonStringArray(json, key);
        out = new uint256[](raw.length);
        for (uint256 i; i < raw.length; ++i) {
            out[i] = vm.parseUint(raw[i]);
        }
    }

    /// @custom:requirement R-VIEW-2
    function test_BpsToTicksDown_SatisfiesPostconditionForAllBps() public view {
        uint256[] memory floors = _ref(".floor");
        assertEq(floors.length, N);
        for (uint256 i; i < N; ++i) {
            uint16 bps = uint16(i + 1);
            uint256 got = BandMath.bpsToTicksDown(bps);
            assertLe(got, floors[i], "never wider than the exact band");
            assertGe(got + 1, floors[i], "at most one tick narrower");
        }
    }

    /// @custom:requirement R-VIEW-2
    function test_BpsToTicksWad_NeverExceedsReference_AndStaysWithinBias() public view {
        uint256[] memory wads = _ref(".wad");
        uint256 maxGap;
        for (uint256 i; i < N; ++i) {
            uint256 got = BandMath.bpsToTicksWad(uint16(i + 1));
            assertLe(got, wads[i], "biased value must not exceed the exact value");
            uint256 gap = wads[i] - got;
            if (gap > maxGap) maxGap = gap;
        }
        // The bias is 1e9 WAD-units (1e-9 ticks); fixed-point error adds well below another 1e9.
        assertLe(maxGap, 2e9, "bias plus fixed-point error stays within 2e-9 ticks");
        assertEq(BandMath.EPS_WAD, 1e9, "epsilon is the documented 1e-9 ticks");
    }

    /// @custom:requirement R-STR-8
    function test_BpsToTicksNearest_EqualsRoundedReferenceForAllBps() public view {
        uint256[] memory nearest = _ref(".nearest");
        for (uint256 i; i < N; ++i) {
            assertEq(
                BandMath.bpsToTicksNearest(uint16(i + 1)),
                nearest[i],
                "round half up of the exact value"
            );
        }
    }

    /// @custom:requirement R-STR-8
    function test_KnownValues_750Bps() public pure {
        // MATH §2: x = 7.5% gives about 779.65 ticks.
        assertEq(BandMath.bpsToTicksDown(750), 779);
        assertEq(BandMath.bpsToTicksNearest(750), 780);
    }

    /// @custom:requirement R-STR-8
    function test_Edges_ZeroAndBeyondRange() public pure {
        assertEq(BandMath.bpsToTicksDown(0), 0);
        assertEq(BandMath.bpsToTicksNearest(0), 0);
        assertEq(BandMath.bpsToTicksDown(10_000), BandMath.MAX_TICK_SPAN);
        assertEq(BandMath.bpsToTicksDown(type(uint16).max), BandMath.MAX_TICK_SPAN);
        assertEq(BandMath.bpsToTicksNearest(10_000), BandMath.MAX_TICK_SPAN);
        // 99.99% fall is about 92_108 ticks, far below the cap.
        assertGt(BandMath.bpsToTicksDown(9999), 92_000);
        assertLt(BandMath.bpsToTicksDown(9999), BandMath.MAX_TICK_SPAN);
        assertEq(BandMath.MAX_TICK_SPAN, uint24(1_774_544));
    }

    /// @custom:requirement R-CFG-1
    function test_StressThresholds_RoundToDistinctTicks_ForAllValidPairs() public pure {
        // Consecutive bps differ by at least ~1.0001 ticks, so exit < enter in bps implies exit < enter in ticks.
        for (uint16 enter = 51; enter <= 2500; ++enter) {
            assertLt(BandMath.bpsToTicksNearest(enter - 1), BandMath.bpsToTicksNearest(enter));
        }
    }

    /// @custom:requirement R-VIEW-2
    function testFuzz_Down_And_Nearest_AreMonotonic(uint16 bps) public pure {
        bps = uint16(bound(bps, 0, 9998));
        assertLe(BandMath.bpsToTicksDown(bps), BandMath.bpsToTicksDown(bps + 1));
        assertLe(BandMath.bpsToTicksNearest(bps), BandMath.bpsToTicksNearest(bps + 1));
        assertLe(BandMath.bpsToTicksDown(bps), BandMath.bpsToTicksNearest(bps));
    }

    /// @custom:requirement R-VIEW-2
    function test_BandEdges_BothDirections_AllScenarios() public pure {
        Scenario[] memory all = Scenarios.all();
        uint24 band = BandMath.bpsToTicksDown(750);
        for (uint256 i; i < all.length; ++i) {
            (int24 near, int24 far) =
                BandMath.bandEdges(all[i].startTick, all[i].collateralIs0, band);
            assertEq(near, all[i].startTick);
            if (all[i].collateralIs0) {
                assertEq(far, all[i].startTick - int24(band), "collateral is token0: ticks fall");
                assertLt(far, near);
            } else {
                assertEq(far, all[i].startTick + int24(band), "collateral is token1: ticks rise");
                assertGt(far, near);
            }
        }
    }

    /// @custom:requirement R-VIEW-2
    function test_BandEdges_ClampToTickBounds() public pure {
        (, int24 far0) = BandMath.bandEdges(TickMath.MIN_TICK + 10, true, 1000);
        assertEq(far0, TickMath.MIN_TICK);
        (, int24 far1) = BandMath.bandEdges(TickMath.MAX_TICK - 10, false, 1000);
        assertEq(far1, TickMath.MAX_TICK);
        (, int24 farHuge) = BandMath.bandEdges(0, true, type(uint24).max);
        assertEq(farHuge, TickMath.MIN_TICK);
        (, int24 farHuge1) = BandMath.bandEdges(0, false, type(uint24).max);
        assertEq(farHuge1, TickMath.MAX_TICK);
    }

    /// @custom:requirement R-VIEW-2
    function testFuzz_BandEdges_OrderedAndBounded(int24 anchor, bool collateralIs0, uint24 band)
        public
        pure
    {
        anchor = int24(bound(int256(anchor), TickMath.MIN_TICK, TickMath.MAX_TICK));
        (int24 near, int24 far) = BandMath.bandEdges(anchor, collateralIs0, band);
        assertEq(near, anchor);
        assertGe(far, TickMath.MIN_TICK);
        assertLe(far, TickMath.MAX_TICK);
        if (collateralIs0) assertLe(far, near);
        else assertGe(far, near);
        uint256 dist =
            far > near ? uint256(int256(far) - int256(near)) : uint256(int256(near) - int256(far));
        assertLe(dist, band);
    }
}
